---
import type { HTMLAttributes } from "astro/types";

export type Props = {
    label: string;
    name: string;
    barHeight?: number;
    diamond?: boolean;
    labels?: number[];
} & Omit<HTMLAttributes<"input">, "type">;

const {
    label,
    name,
    id = name,
    dir,
    barHeight = 4,
    diamond = false,
    labels,
    min = 0,
    max = 100,
    ...input
} = Astro.props;
if (!Number.isFinite(barHeight) || barHeight <= 0) {
    throw new Error("Range barHeight must be a positive number.");
}
const thumbSize = Math.max(diamond ? 17 : 16, barHeight + 10);
const parsedMin = Number.parseFloat(String(min));
const parsedMax = Number.parseFloat(String(max));
const minimum = Number.isFinite(parsedMin) ? parsedMin : 0;
const maximum = Number.isFinite(parsedMax) ? parsedMax : 100;
const markers = (labels ?? [minimum, maximum]).filter((value) =>
    Number.isFinite(value) && value >= minimum && value <= maximum
);
const position = (value: number) => maximum > minimum
    ? (value - minimum) / (maximum - minimum) * 100
    : 0;
---

<div
    class="range"
    {dir}
    data-cm-range
    style={{ "--bar-height": `${barHeight}px`, "--thumb-size": `${thumbSize}px` }}
>
    <div class="heading">
        <label for={id}>{label}</label>
        <output for={id} aria-hidden="true"></output>
    </div>
    <input {...input} type="range" {name} {id} {min} {max} data-diamond={diamond || undefined} />
    {markers.length > 0 && (
        <div class:list={["labels", { marked: labels !== undefined }]} aria-hidden="true">
            {markers.map((value) => <span style={{ "--label-position": `${position(value)}%` }}>{value}</span>)}
        </div>
    )}
</div>

<script>
    let listeners: AbortController | undefined;

    function initReadouts() {
        listeners?.abort();
        listeners = new AbortController();
        const { signal } = listeners;
        for (const range of document.querySelectorAll<HTMLElement>("[data-cm-range]")) {
            const input = range.querySelector("input")!;
            const output = range.querySelector("output")!;
            const update = () => output.value = input.value;
            input.addEventListener("input", update, { signal });
            input.addEventListener("change", update, { signal });
            input.form?.addEventListener("reset", () => requestAnimationFrame(update), { signal });
            update();
        }
    }

    document.addEventListener("astro:page-load", initReadouts);
    initReadouts();
</script>

<style>
    .range {
        /* TODO: Check thumb and label contrast when light themes are supported. */
        --fill: rgb(var(--cmpurple));
        --empty: #666;
        --thumb: white;
        margin: 0.55em 0;
        min-width: 0;
    }
    .range:has(input[hidden]),
    [hidden] {
        display: none;
    }
    .heading {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1em;
        margin-bottom: 0.65em;
    }
    output {
        color: #c0c0c0;
        font-variant-numeric: tabular-nums;
    }
    input {
        --direction: to right;
        --track: linear-gradient(var(--direction), var(--fill) 50%, var(--empty) 0);
        --thumb-shape: radial-gradient(circle closest-side, var(--thumb) 98%, transparent);
        display: block;
        appearance: none;
        width: 100%;
        height: max(32px, var(--thumb-size), var(--bar-height));
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
        overflow: hidden;
        cursor: pointer;
    }
    input:dir(rtl) {
        --direction: to left;
    }
    input[data-diamond] {
        --thumb-shape:
            conic-gradient(from 135deg at 50% 0, var(--thumb) 90deg, transparent 0) top / 100% 50% no-repeat,
            conic-gradient(from -45deg at 50% 100%, var(--thumb) 90deg, transparent 0) bottom / 100% 50% no-repeat;
    }
    input::-webkit-slider-runnable-track {
        height: var(--bar-height);
        border-radius: 999px;
        background: var(--empty);
    }
    input::-moz-range-track {
        height: var(--bar-height);
        border-radius: 999px;
        background: var(--empty);
    }
    input::-moz-range-progress {
        height: var(--bar-height);
        border-radius: 999px;
        background: var(--fill);
    }
    input::-webkit-slider-thumb {
        appearance: none;
        width: var(--thumb-size);
        height: var(--thumb-size);
        margin-top: calc((var(--bar-height) - var(--thumb-size)) / 2);
        border: 0;
        border-radius: 0;
        background: var(--thumb-shape), var(--track) center / 100% var(--bar-height) no-repeat;
        /* The thumb carries the fill; clip its extended border image to the track height. */
        border-image: var(--track) 1 / 0 100vw / 0 100vw;
        --track-top: calc(50% - var(--bar-height) / 2);
        --track-bottom: calc(50% + var(--bar-height) / 2);
        clip-path: polygon(
            0 0, 100% 0,
            100% var(--track-top), 100vw var(--track-top),
            100vw var(--track-bottom), 100% var(--track-bottom),
            100% 100%, 0 100%,
            0 var(--track-bottom), -100vw var(--track-bottom),
            -100vw var(--track-top), 0 var(--track-top)
        );
    }
    input::-moz-range-thumb {
        width: var(--thumb-size);
        height: var(--thumb-size);
        border: 0;
        border-radius: 0;
        background: var(--thumb-shape), var(--track) center / 100% var(--bar-height) no-repeat;
    }
    input:focus-visible {
        outline: 2px solid rgb(var(--cmpurple));
        outline-offset: 3px;
        border-radius: 4px;
    }
    .range:has(input:disabled) {
        --fill: #666;
        --thumb: #999;
    }
    input:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }
    .labels {
        position: relative;
        min-height: 1.8em;
        margin-inline: calc(var(--thumb-size) / 2);
        margin-top: 0.3em;
        font-size: 0.8em;
        color: #999;
    }
    .labels span {
        position: absolute;
        inset-inline-start: var(--label-position, 0%);
        transform: translateX(-50%);
        white-space: nowrap;
    }
    .labels:dir(rtl) span {
        transform: translateX(50%);
    }
    .marked span::before {
        content: "";
        display: block;
        width: 1px;
        height: 5px;
        margin: 0 auto 0.3em;
        background: #666;
    }
    @media (forced-colors: active) {
        input {
            appearance: auto;
        }
        input::-webkit-slider-runnable-track {
            background: Canvas;
            border: 1px solid ButtonText;
        }
        input::-webkit-slider-thumb {
            background: ButtonText;
            border-image: none;
            clip-path: none;
        }
        input::-moz-range-track {
            background: Canvas;
            border: 1px solid ButtonText;
        }
        input::-moz-range-thumb {
            background: ButtonText;
        }
        input::-moz-range-progress {
            background: Highlight;
        }
    }
</style>
