---
import type { HTMLAttributes } from "astro/types";

export type Props = { label: string } & Omit<HTMLAttributes<"input">, "type">;

const { label, ...input } = Astro.props;
---

<label>
    <input role="switch" {...input} type="checkbox" />
    <span aria-hidden="true"></span>
    <span>{label}</span>
</label>

<style>
    label {
        display: inline-flex;
        align-items: center;
        gap: 0.8em;
        position: relative;
        max-width: 100%;
        cursor: pointer;
    }
    label:has(input[hidden]) {
        display: none;
    }
    input {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: 0;
        opacity: 0;
    }
    input + span {
        position: relative;
        width: 48px;
        height: 24px;
        flex-shrink: 0;
        background: #111;
        box-shadow: inset 0 0 0 2px #666;
        transition: background-color 120ms;
    }
    input + span::before {
        content: "";
        position: absolute;
        inset-block-start: 3px;
        inset-inline-start: 3px;
        width: 18px;
        height: 18px;
        background: white;
        transition: inset-inline-start 120ms;
    }
    input:checked + span {
        background: rgb(var(--cmpurple));
        box-shadow: inset 0 0 0 2px rgb(var(--cmpurple));
    }
    input:checked + span::before {
        inset-inline-start: 27px;
    }
    input:focus-visible + span {
        outline: 2px solid rgb(var(--cmpurple));
        outline-offset: 3px;
    }
    label:has(input:disabled) {
        opacity: 0.6;
        cursor: not-allowed;
    }
    input:disabled + span {
        background: #666;
        box-shadow: inset 0 0 0 2px #666;
    }
    span:last-child {
        min-width: 0;
        overflow-wrap: anywhere;
    }
    @media (prefers-reduced-motion: reduce) {
        input + span,
        input + span::before {
            transition: none;
        }
    }
    @media (forced-colors: active) {
        input {
            position: static;
            width: 1em;
            height: 1em;
            opacity: 1;
        }
        input + span {
            display: none;
        }
    }
</style>
