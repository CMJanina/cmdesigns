---
import type { HTMLAttributes } from "astro/types";

export type Props = { layout?: "stacked" | "inline" } & HTMLAttributes<"header">;

const { layout = "stacked", ...attributes } = Astro.props;
---

<header {...attributes}>
    <div data-layout={layout}>
        <slot />
        {Astro.slots.has("navigation") && <nav><slot name="navigation" /></nav>}
    </div>
</header>

<style>
    header {
        container-type: inline-size;
    }
    div {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0;
        text-align: center;
    }
    nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem 2rem;
        min-width: 0;
        max-width: 100%;
    }
    header nav > :global(*) {
        box-sizing: border-box;
        min-width: 0;
        max-width: 100%;
        white-space: normal;
        overflow-wrap: anywhere;
    }
    @container (min-width: 44rem) {
        div[data-layout="inline"] {
            flex-direction: row;
            justify-content: space-between;
            text-align: left;
        }
        div[data-layout="inline"] nav {
            justify-content: flex-end;
        }
    }
</style>
