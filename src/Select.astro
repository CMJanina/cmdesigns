---
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"select">;
---

<select {...Astro.props}>
    <slot />
</select>

<style>
    select {
        min-width: 0;
        padding: 0.25em 0.5em;
        border: 1px solid #666;
        border-radius: 0.25rem;
        /* TODO: Adapt these colors when light themes are supported. */
        background: black;
        color: white;
        font: inherit;
        cursor: pointer;
    }
    select:focus-visible {
        outline: 2px solid rgb(var(--cmpurple));
        outline-offset: 2px;
        border-color: white;
    }
    select:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>
