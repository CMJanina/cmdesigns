---
import type { HTMLAttributes } from "astro/types";

export type Props = HTMLAttributes<"fieldset"> & {
    label: string;
    name: string;
    type?: "radio" | "checkbox";
    options: ({ label: string } & Omit<HTMLAttributes<"input">, "name" | "type">)[];
};

const { label, name, type = "radio", options, form, ...attributes } = Astro.props;
---

<fieldset {...attributes} {form}>
    <legend>{label}</legend>
    <div>
        {options.map(({ label, ...input }) => (
            <label>
                <input {form} {...input} {type} {name} />
                <span>{label}</span>
            </label>
        ))}
    </div>
</fieldset>

<style>
    fieldset {
        border: 0;
        margin: 0.55em 0;
        padding: 0;
        min-width: 0;
    }
    [hidden],
    label:has(input[hidden]) {
        display: none;
    }
    legend {
        padding: 0;
        margin-bottom: 0.75em;
        color: #c0c0c0;
        font-size: 0.9em;
    }
    div {
        display: flex;
        flex-direction: column;
        gap: 0.6em;
    }
    label {
        position: relative;
        min-width: 0;
        cursor: pointer;
    }
    input {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: 0;
        opacity: 0;
    }
    span {
        display: flex;
        align-items: center;
        gap: 0.5em;
        line-height: 1.2;
        overflow-wrap: anywhere;
    }
    span::before {
        content: "";
        box-sizing: border-box;
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        border: 2px solid #666;
        background: black;
        box-shadow: inset 0 0 0 3px black;
    }
    input[type="radio"] + span::before {
        clip-path: polygon(25% 0, 75% 0, 100% 25%, 100% 75%, 75% 100%, 25% 100%, 0 75%, 0 25%);
    }
    input:checked + span::before {
        background: rgb(var(--cmpurple));
        border-color: rgb(var(--cmpurple));
    }
    input:focus-visible + span {
        outline: 2px solid rgb(var(--cmpurple));
        outline-offset: 3px;
    }
    label:has(input:disabled) {
        opacity: 0.45;
        cursor: not-allowed;
    }
    @media (forced-colors: active) {
        span::before {
            forced-color-adjust: none;
            background: Canvas;
            border-color: CanvasText;
            box-shadow: inset 0 0 0 3px Canvas;
        }
        input:checked + span::before {
            background: Highlight;
            border-color: Highlight;
        }
    }
</style>
