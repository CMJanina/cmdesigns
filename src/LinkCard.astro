---
import type { HTMLAttributes } from "astro/types";

export type Props = { gradient?: string; frame?: boolean } & (
    | ({ href: string } & HTMLAttributes<"a">)
    | ({ href?: undefined } & HTMLAttributes<"div">)
);

const { href, gradient, frame = true, class: className, style, ...attributes } = Astro.props;
const Tag = href === undefined ? "div" : "a";
const cardStyle = typeof style === "string"
    ? `${style};--link-card-gradient:${gradient ?? "none"}`
    : { ...style, "--link-card-gradient": gradient };
---

<Tag
    {...attributes}
    {href}
    class:list={["cm-link-card", className]}
    style={cardStyle}
    data-gradient={gradient ? "" : undefined}
    data-frame={gradient && frame ? "" : undefined}
>
    <div class="content"><slot /></div>
</Tag>

<style>
    .cm-link-card {
        position: relative;
        display: flex;
        min-width: 0;
        box-sizing: border-box;
        padding: 1rem;
        border: 1px solid #333333;
        border-radius: 0.8rem;
        background: #0f0f0f;
        color: white;
        text-decoration: none;
        overflow-wrap: anywhere;
    }
    [hidden] {
        display: none;
    }
    a:not([data-gradient]):is(:hover, :focus-visible) {
        background: #333333;
    }
    a:focus-visible {
        outline: 2px solid;
        outline-offset: 3px;
    }
    .content {
        position: relative;
        width: 100%;
        min-width: 0;
    }
    [data-gradient]::before {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background-image: var(--link-card-gradient);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    a[data-gradient]:is(:hover, :focus-visible)::before {
        opacity: 1;
    }
    [data-frame] {
        padding: 0.25rem;
    }
    [data-frame] > .content {
        box-sizing: border-box;
        padding: 0.75rem;
        border-radius: 0.5rem;
        background: rgb(15 15 15 / 0.8);
    }
    @media (prefers-reduced-motion: reduce) {
        [data-gradient]::before {
            transition: none;
        }
    }
</style>
