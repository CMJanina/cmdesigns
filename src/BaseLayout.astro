---
import Favicon from "astro-favicon";
import MinimalLayout, {
    type Props as MinimalLayoutProps,
} from "./MinimalLayout.astro";
import baseStyles from "./BaseLayout.css?url";

export interface Props extends MinimalLayoutProps {
    favicon?: ImageMetadata | string;
    themecolor?: string;
}

const { favicon, themecolor, ...layout } = Astro.props;
---

<MinimalLayout {...layout}>
    {themecolor && <meta name="theme-color" content={themecolor} slot="head" />}
    {favicon && <Favicon src={favicon} slot="head" />}
    <meta name="generator" content={Astro.generator} slot="head" />
    <meta name="darkreader-lock" slot="head" />
    <link rel="stylesheet" href="https://fonts.chrissx.de/" slot="head" />
    <link rel="stylesheet" href={baseStyles} slot="head" />
    <slot name="head" slot="head" />
    <slot />
</MinimalLayout>
